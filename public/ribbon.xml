<customUI xmlns="http://schemas.microsoft.com/office/2006/01/customui" onLoad="ribbon.OnAddinLoad">
    <ribbon startFromScratch="false">
        <tabs>
            <tab id="wpsAddinTab" label="HND插件" getVisible="ribbon.OnGetTabVisible">
                <group id="mainGroup" label="">
                    <!-- 填入图片按钮 -->
                <button id="btnFillImage" label="填入图片" onAction="ribbon.OnAction" enabled="true" getImage="ribbon.GetImage" getVisible="ribbon.OnGetVisible" size="large"/>
                <!-- 添加批注按钮 -->
                <button id="btnAddComment" label="添加批注" onAction="ribbon.OnAction" enabled="true" getImage="ribbon.GetImage" getVisible="ribbon.OnGetVisible" size="large"/>
                <!-- 物料查询按钮 -->
                <button id="btnMaterialQuery" label="物料查询" onAction="ribbon.OnAction" enabled="true" getImage="ribbon.GetImage" getVisible="ribbon.OnGetVisible" size="large"/>
                <!-- 动态时间按钮 -->
                <button id="btnDynamicTime" label="动态时间" onAction="ribbon.OnAction" enabled="true" getImage="ribbon.GetImage" getVisible="ribbon.OnGetVisible" size="large"/>
                <!-- 科学计算器按钮 -->
                <button id="btnScientificCalculator" label="科学计算器" onAction="ribbon.OnAction" enabled="true" getImage="ribbon.GetImage" getVisible="ribbon.OnGetVisible" size="large"/>
                <!-- 汇率换算按钮 -->
                <button id="btnCurrencyConverter" label="汇率换算" onAction="ribbon.OnAction" enabled="true" getImage="ribbon.GetImage" getVisible="ribbon.OnGetVisible" size="large"/>
                <!-- 储罐容积计算按钮 -->
                <button id="btnTankVolume" label="储罐容积计算" onAction="ribbon.OnAction" enabled="true" getImage="ribbon.GetImage" getVisible="ribbon.OnGetVisible" size="large"/>
                <!-- 二维码按钮 -->
                <button id="btnQRCode" label="二维码" onAction="ribbon.OnAction" enabled="true" getImage="ribbon.GetImage" getVisible="ribbon.OnGetVisible" size="large"/>
                <!-- 数独按钮 -->
                <button id="btnMoyu" label="数独" onAction="ribbon.OnAction" enabled="true" getImage="ribbon.GetImage" getVisible="ribbon.OnGetVisible" size="large"/>
                <!-- 俄罗斯方块按钮 -->
                <button id="btnTetris" label="俄罗斯方块" onAction="ribbon.OnAction" enabled="true" getImage="ribbon.GetImage" getVisible="ribbon.OnGetVisible" size="large"/>

                </group>
            </tab>
        </tabs>
    </ribbon>
</customUI>